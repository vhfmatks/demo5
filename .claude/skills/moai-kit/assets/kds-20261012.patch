+import { test, expect } from "./fixtures";
+import type { Page, TestInfo } from "@playwright/test";
+
+async function compareViewport(page: Page, testInfo: TestInfo, screen: string, width: number, height: number) {
+    await page.setViewportSize({ width, height });
+    await page.goto(`/kds/${screen}.html`);
+    // Both screens must use the same participant-only font environment.
+    await page.addStyleTag({ url: "/api/v1/local-font-style" });
+    await page.evaluate(() => document.fonts.ready);
+    const reference = await page.screenshot({ fullPage: true, animations: "disabled" });
+    await page.goto(`/design-system/kds/${screen}`);
+    await page.evaluate(() => document.fonts.ready);
+    await expect(page.locator(`[data-kds-screen="${screen}"]`)).toBeVisible();
+    const migrated = await page.screenshot({ fullPage: true, animations: "disabled" });
+    await testInfo.attach(`organizer-${width}`, { body: reference, contentType: "image/png" });
+    await testInfo.attach(`react-${width}`, { body: migrated, contentType: "image/png" });
+    const diff = await page.evaluate(async ({ a, b }) => {
+      const decode = (source: string) => new Promise<HTMLImageElement>((resolve, reject) => {
+        const image = new window.Image();
+        image.onload = () => resolve(image);
+        image.onerror = () => reject(new Error("Screenshot decode failed"));
+        image.src = `data:image/png;base64,${source}`;
+      });
+      const [left, right] = await Promise.all([decode(a), decode(b)]);
+      if (left.width !== right.width || left.height !== right.height) return { dimensions: false, pixels: -1, left: [left.width, left.height], right: [right.width, right.height] };
+      const canvas = document.createElement("canvas");
+      canvas.width = left.width; canvas.height = left.height;
+      const context = canvas.getContext("2d");
+      if (!context) throw new Error("Canvas unavailable");
+      context.drawImage(left, 0, 0);
+      const x = context.getImageData(0, 0, canvas.width, canvas.height).data;
+      context.clearRect(0, 0, canvas.width, canvas.height);
+      context.drawImage(right, 0, 0);
+      const y = context.getImageData(0, 0, canvas.width, canvas.height).data;
+      let pixels = 0;
+      for (let i = 0; i < x.length; i += 4) if (x[i] !== y[i] || x[i + 1] !== y[i + 1] || x[i + 2] !== y[i + 2] || x[i + 3] !== y[i + 3]) pixels++;
+      return { dimensions: true, pixels, left: [left.width, left.height], right: [right.width, right.height] };
+    }, { a: reference.toString("base64"), b: migrated.toString("base64") });
+    await testInfo.attach(`pixel-diff-${width}`, { body: JSON.stringify(diff), contentType: "application/json" });
+    expect(diff.dimensions, JSON.stringify(diff)).toBe(true);
+    expect(diff.pixels, `${screen}: ${JSON.stringify(diff)}`).toBe(0);
+}
+
+async function compareScreen(page: Page, testInfo: TestInfo, screen: string, width: number, height: number) {
+  const widths = width < 1280 ? [360, width, 480] : [1280, width, 1920];
+  for (const size of widths) await compareViewport(page, testInfo, screen, size, height);
+}
+
+test("TC-KDS-UI-001 templates/mobile-task 원본과 React 화면 픽셀 일치", async ({ page }, testInfo) => { await compareScreen(page, testInfo, "templates/mobile-task", 390, 844); });
