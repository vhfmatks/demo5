+/** Select through the public KDS calendar instead of filling a readonly display input. */
+export async function selectKdsDate(page: Page, label: string, iso: string) {
+  const [year, month, day] = iso.split("-").map(Number);
+  await page.getByRole("combobox", { name: label, exact: true }).click();
+  const calendar = page.getByRole("dialog", { name: `${label} 날짜 선택`, exact: true });
+  for (let attempt = 0; attempt < 240; attempt++) {
+    const title = await calendar.locator(".kds-calendar__title").innerText();
+    const parts = /^(\d+)년 (\d+)월$/.exec(title);
+    if (!parts) throw new Error(`달력 제목을 읽지 못했습니다: ${title}`);
+    const difference = (year - Number(parts[1])) * 12 + month - Number(parts[2]);
+    if (!difference) { await calendar.getByRole("button", { name: `${year}년 ${month}월 ${day}일`, exact: true }).click(); return; }
+    await calendar.getByRole("button", { name: difference > 0 ? "다음 달" : "이전 달", exact: true }).click();
+  }
+  throw new Error(`달력 이동 범위를 초과했습니다: ${iso}`);
+}
